{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "bun": "1.3.14"
  },
  "steps": {
    "install": {
      "variables": {
        "HUSKY": "0"
      }
    }
  },
  "deploy": {
    "startCommand": "bun build/index.js",
    "variables": {
      "NODE_ENV": "production",
      "PROTOCOL_HEADER": "x-forwarded-proto",
      "HOST_HEADER": "x-forwarded-host"
    }
  }
}
