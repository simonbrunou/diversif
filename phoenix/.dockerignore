# Source: things the builder doesn't need to copy.

# Build artifacts the builder regenerates anyway. Note: we ONLY ignore the
# bundled css/js output (regenerated by phx.digest); priv/static/images,
# favicon.ico and robots.txt stay in the image.
_build/
cover/
deps/
doc/
priv/static/assets/css/
priv/static/assets/js/

# Local environment.
.git/
.gitignore
.formatter.exs
.elixir_ls/
.elixir-tools/
*.ez

# Test data.
test/
priv/repo/seeds.exs

# Editor / IDE.
.vscode/
.idea/
*.swp

# Local dev helpers that don't belong in prod.
docker-compose.yml
bin/test
tmp/

# Already in the image via the release archive.
Dockerfile
.dockerignore
