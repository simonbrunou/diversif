{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "entry": [
    "src/env.ts!",
    "src/**/*.test.ts!",
    "src/test/**!",
    "scripts/**/*.ts!",
    "e2e/**/*.ts!",
    "eslint-rules/**/*.js!",
    "*.preload.ts!",
    "paraglide.config.ts!"
  ],
  "project": ["src/**/*.{ts,js,svelte,css}!"],
  "ignoreDependencies": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss", "happy-dom"],
  "ignoreBinaries": ["Tools"],
  // tsconfig.json extends "$app/tsconfig", which SvelteKit 3 writes into node_modules/$app on
  // sync, with no package.json. Since knip 6.45 that reads as the unlisted package "$app", and
  // an ignoreDependencies entry fails as an unused-ignore hint. This file lists no other package.
  "ignoreIssues": { "tsconfig.json": ["unlisted"] }
}
