{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/hooks.ts!",
    "src/**/*.test.ts!",
    "src/test/**!",
    "scripts/**/*.ts!",
    "e2e/**/*.ts!",
    "*.preload.ts!",
    "paraglide.config.ts!"
  ],
  "project": ["src/**/*.{ts,js,svelte}!"],
  "ignoreDependencies": [
    "@fontsource-variable/inter",
    "@fontsource-variable/fraunces",
    "tailwindcss",
    "tw-animate-css",
    "prettier-plugin-svelte",
    "prettier-plugin-tailwindcss",
    "svelte-check",
    "happy-dom",
    "fallow",
    "vite-plugin-pwa"
  ],
  "ignoreBinaries": ["Tools"]
}
