{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "entry": [
    "src/env.ts!",
    "src/**/*.test.ts!",
    "src/test/**!",
    "scripts/**/*.ts!",
    "e2e/**/*.ts!",
    "eslint-rules/**/*.js!",
    "*.preload.ts!",
    "paraglide.config.ts!"
  ],
  "project": ["src/**/*.{ts,js,svelte,css}!"],
  "ignoreDependencies": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss", "happy-dom"],
  "ignoreBinaries": ["Tools"]
}
