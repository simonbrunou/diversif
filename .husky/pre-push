#!/usr/bin/env bash
# pre-push: run the same gates CI runs, so a broken push is caught
# locally instead of by GitHub Actions five minutes later.
#
# Set SKIP_PUSH_TESTS=1 to bypass (use only when you know what you're doing,
# e.g. docs-only changes you've already verified — CI will still gate the
# branch).

set -euo pipefail

if [ "${SKIP_PUSH_TESTS:-0}" = "1" ]; then
  echo "pre-push: SKIP_PUSH_TESTS=1 set, skipping local CI mirror."
  exit 0
fi

start=$(date +%s)
log() { printf '\n\033[1;34m→ %s\033[0m\n' "$1"; }
ok()  { printf '\033[1;32m✓ %s\033[0m\n' "$1"; }
warn(){ printf '\033[1;33m! %s\033[0m\n' "$1"; }

# File-pattern detection: surface the slow CI gates that this hook would
# otherwise skip, but only when files in their target paths actually
# changed (so docs-only / unrelated pushes stay fast).
#
# Coverage gate: vitest's 100% threshold lives in CI's test:coverage job,
# NOT in `npm test`. Touching anything that contributes to the coverage
# surface (hooks, sentry init, lib/server tree, vite.config) means we
# want the threshold validated locally before push.
#
# Docker gate: Coolify deploys are docker builds, and docker is NOT in
# CI. A broken Dockerfile / entrypoint / dockerignore only surfaces in
# the production deploy log. `docker build --check` is a BuildKit lint
# (no RUN exec, no DATABASE_URL needed). The .git-less context replay
# catches the specific class of failure that bit us on PR #?? — a RUN
# step shelling out to git when Coolify's archive-based context has no
# .git directory.
CHANGED_FILES=""
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  CHANGED_FILES=$(git diff --name-only origin/main..HEAD 2>/dev/null || true)
fi
NEEDS_COVERAGE=0
NEEDS_DOCKER_CHECK=0
if printf '%s\n' "$CHANGED_FILES" | grep -qE '^(src/hooks\.|src/lib/sentry|src/lib/server/|vite\.config\.ts)'; then
  NEEDS_COVERAGE=1
fi
if printf '%s\n' "$CHANGED_FILES" | grep -qE '^(Dockerfile|docker-entrypoint\.sh|\.dockerignore)'; then
  NEEDS_DOCKER_CHECK=1
fi

log "lint (prettier + eslint + i18n)"
npm run lint
ok "lint passed"

log "typecheck (svelte-check)"
npm run check
ok "typecheck passed"

if [ "$NEEDS_COVERAGE" = "1" ]; then
  log "unit + component tests (vitest --coverage, 100% threshold)"
  npm run test:coverage
  ok "coverage passed"
else
  log "unit + component tests (vitest)"
  npm test
  ok "unit tests passed"
fi

if [ "$NEEDS_DOCKER_CHECK" = "1" ]; then
  if command -v docker >/dev/null 2>&1; then
    log "docker syntax check (BuildKit --check)"
    DOCKER_BUILDKIT=1 docker build --check . >/dev/null
    ok "docker --check passed"

    # .git-less build probe: Coolify's archive-based deploys strip .git/
    # from the build context. RUN steps that shell out to git work fine
    # locally (where .git/ is present) but explode in production. Replay
    # the build against a tar pipe that excludes .git so any such RUN
    # failure surfaces here, not in the deploy log.
    #
    # We can't fully build (npm run build needs DATABASE_URL which we
    # don't want to bake into the hook), so the probe accepts failure
    # AT the npm-run-build RUN — that's expected — and treats any
    # earlier failure (especially git-related) as the bug we're hunting.
    log "docker .git-less probe (catches RUN steps that need git/.git)"
    PROBE_OUT=$(mktemp)
    trap 'rm -f "$PROBE_OUT"' EXIT
    set +e
    tar --exclude=.git --exclude=node_modules --exclude=.svelte-kit \
        --exclude=build --exclude=coverage --exclude=data \
        -cf - . | DOCKER_BUILDKIT=1 docker build --target builder - >"$PROBE_OUT" 2>&1
    PROBE_EXIT=$?
    set -e
    if [ "$PROBE_EXIT" -eq 0 ]; then
      # Unexpected: a no-DATABASE_URL build shouldn't reach completion.
      # Either the Dockerfile gained a build-arg pathway (great, the
      # hook becomes a stricter gate) or analyse stopped requiring DB
      # (also fine). Either way, no failure to report.
      ok "docker .git-less probe passed (build completed)"
    elif grep -q "DATABASE_URL is required" "$PROBE_OUT"; then
      # Expected failure: analyse hit the resolveDatabaseUrl() throw.
      # That means every RUN step BEFORE npm run build succeeded —
      # including any git-touching ones — under a .git-less context.
      ok "docker .git-less probe passed (failed at npm run build, as expected)"
    else
      tail -30 "$PROBE_OUT" >&2
      warn "docker .git-less probe failed BEFORE npm run build — likely a RUN step that needs .git/ or git binary."
      exit 1
    fi
  else
    warn "docker not available — Dockerfile/entrypoint/dockerignore changed but can't be checked locally."
    warn "run \`docker build --check .\` on a machine that has docker before pushing."
  fi
fi

# E2E: mirror what CI does. CI brings up a fresh postgres service container.
# Locally we use whatever is reachable on :5432, or spin one up via docker if
# we can. Without postgres we warn and skip — better than refusing to push,
# but the user sees the gap.
log "e2e (Playwright, full suite — desktop + mobile projects)"

E2E_HOST="${E2E_DATABASE_URL:-postgres://diversif:diversif@localhost:5432/diversif_e2e}"
PG_CONTAINER=""     # container we can run psql in (for DB reset)
PG_OWNED_BY_HOOK="" # only set if WE started the container — only then do we stop it

reset_db() {
  # Drop + recreate the DB so a fresh migration journal lands every run.
  # The bundled scripts/reset-e2e-db.mjs already drops both `public` and
  # `drizzle` schemas, so it's safe to use as a fallback when we don't have
  # a container reference (non-docker postgres on :5432).
  if [ -n "$PG_CONTAINER" ]; then
    docker exec -i "$PG_CONTAINER" psql -U diversif -d postgres >/dev/null <<'SQL'
DROP DATABASE IF EXISTS diversif_e2e;
CREATE DATABASE diversif_e2e;
SQL
  else
    E2E_DATABASE_URL="$E2E_HOST" node scripts/reset-e2e-db.mjs >/dev/null
  fi
}

cleanup_pg() {
  # Only stop the container if the hook started it. A pre-existing one
  # belongs to the user; leave it running.
  if [ -n "$PG_OWNED_BY_HOOK" ]; then
    docker stop "$PG_OWNED_BY_HOOK" >/dev/null 2>&1 || true
  fi
}
trap cleanup_pg EXIT

# Detection: prefer a running docker container on :5432 (most common dev
# setup), fall back to a raw TCP probe on /dev/tcp (bash builtin — `nc`
# isn't installed everywhere).
PG_CONTAINER=$(docker ps --filter publish=5432 --format '{{.Names}}' 2>/dev/null | head -1 || true)
port_open() { (echo >/dev/tcp/localhost/5432) >/dev/null 2>&1; }
# Probe Postgres reachability inside the container — a non-Postgres process
# publishing :5432 (or a Postgres still booting) would falsely satisfy the
# docker-filter match. pg_isready exits 0 only when the server accepts conns.
pg_container_ready() {
  [ -n "$PG_CONTAINER" ] && docker exec "$PG_CONTAINER" pg_isready -U diversif >/dev/null 2>&1
}

if [ -n "$PG_CONTAINER" ] && pg_container_ready; then
  echo "  postgres on :5432 (container $PG_CONTAINER) — reusing"
elif port_open; then
  # Either the candidate container isn't actually Postgres / isn't ready, or
  # something non-docker is listening. Either way, the raw port is open — fall
  # back to the non-docker path so reset_db uses scripts/reset-e2e-db.mjs
  # (which talks to the URL directly) rather than `docker exec` on the wrong
  # container.
  if [ -n "$PG_CONTAINER" ]; then
    echo "  postgres candidate container $PG_CONTAINER failed pg_isready — treating :5432 as non-docker"
    PG_CONTAINER=""
  fi
  echo "  postgres on :5432 (non-docker) — reusing"
elif command -v docker >/dev/null 2>&1; then
  echo "  no postgres on :5432 — spinning up a throwaway container"
  PG_OWNED_BY_HOOK="diversif-pre-push-$$"
  PG_CONTAINER="$PG_OWNED_BY_HOOK"
  docker run --rm -d --name "$PG_OWNED_BY_HOOK" \
    -e POSTGRES_USER=diversif -e POSTGRES_PASSWORD=diversif -e POSTGRES_DB=diversif_e2e \
    -p 5432:5432 postgres:16-alpine >/dev/null
  # Wait for postgres to accept connections against the target user/db.
  # `pg_isready` returns 0 while the image's init step is still bouncing
  # the temporary daemon, so connections issued at that moment can be
  # dropped mid-query. SELECT 1 against the actual target database is the
  # reliable readiness signal.
  ready=0
  for _ in $(seq 1 60); do
    if docker exec "$PG_OWNED_BY_HOOK" psql -U diversif -d diversif_e2e -c 'SELECT 1' >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.5
  done
  if [ "$ready" -eq 0 ]; then
    warn "postgres container started but never became ready in 30s"
    exit 1
  fi
else
  warn "no postgres on :5432 and no docker available — skipping e2e"
  warn "CI will still gate the branch. To run e2e locally, install docker or"
  warn "expose a postgres on :5432 with user/db = diversif."
  end=$(date +%s)
  printf '\n\033[1;32mpre-push gates passed (e2e skipped) in %ss\033[0m\n' "$((end - start))"
  exit 0
fi

reset_db
# Skip `npm run test:e2e` because its `node scripts/reset-e2e-db.mjs &&`
# prefix would race the docker-exec reset we just did. We've already
# reset; invoke playwright directly.
E2E_DATABASE_URL="$E2E_HOST" npx playwright test
ok "e2e passed"

end=$(date +%s)
printf '\n\033[1;32mpre-push gates passed in %ss\033[0m\n' "$((end - start))"
