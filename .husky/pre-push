#!/usr/bin/env bash
# pre-push: fast static gates only — lint (prettier + eslint + i18n) and
# typecheck (svelte-check). The full test suite (unit/component, the
# test:coverage 100% threshold, docker --check, and Playwright e2e) was
# intentionally removed so pushes aren't held up for minutes. GitHub Actions
# CI still runs all of those and gates the branch.
#
# Set SKIP_PUSH_TESTS=1 to bypass even these static checks.
set -euo pipefail

if [ "${SKIP_PUSH_TESTS:-0}" = "1" ]; then
  echo "pre-push: SKIP_PUSH_TESTS=1 set, skipping local checks."
  exit 0
fi

start=$(date +%s)
log() { printf '\n\033[1;34m→ %s\033[0m\n' "$1"; }
ok()  { printf '\033[1;32m✓ %s\033[0m\n' "$1"; }

log "lint (prettier + eslint + i18n)"
bun run lint
ok "lint passed"

log "typecheck (svelte-check)"
bun run check
ok "typecheck passed"

end=$(date +%s)
printf '\n\033[1;32mpre-push static gates passed in %ss\033[0m\n' "$((end - start))"
