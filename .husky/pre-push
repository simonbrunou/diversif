#!/usr/bin/env bash
# pre-push: run the same gates CI runs, so a broken push is caught
# locally instead of by GitHub Actions five minutes later.
#
# Set SKIP_PUSH_TESTS=1 to bypass (use only when you know what you're doing,
# e.g. docs-only changes you've already verified — CI will still gate the
# branch).

set -euo pipefail

if [ "${SKIP_PUSH_TESTS:-0}" = "1" ]; then
  echo "pre-push: SKIP_PUSH_TESTS=1 set, skipping local CI mirror."
  exit 0
fi

start=$(date +%s)
log() { printf '\n\033[1;34m→ %s\033[0m\n' "$1"; }
ok()  { printf '\033[1;32m✓ %s\033[0m\n' "$1"; }
warn(){ printf '\033[1;33m! %s\033[0m\n' "$1"; }

log "lint (prettier + eslint + i18n)"
npm run lint
ok "lint passed"

log "typecheck (svelte-check)"
npm run check
ok "typecheck passed"

log "unit + component tests (vitest)"
npm test
ok "unit tests passed"

# E2E: mirror what CI does. CI brings up a fresh postgres service container.
# Locally we use whatever is reachable on :5432, or spin one up via docker if
# we can. Without postgres we warn and skip — better than refusing to push,
# but the user sees the gap.
log "e2e (Playwright, full suite — desktop + mobile projects)"

E2E_HOST="${E2E_DATABASE_URL:-postgres://diversif:diversif@localhost:5432/diversif_e2e}"
PG_CONTAINER=""

reset_db() {
  # Drop + recreate the DB so a fresh migration journal lands every run.
  # The bundled scripts/reset-e2e-db.mjs only drops the `public` schema,
  # which leaves drizzle's migration journal behind and makes repeated
  # local runs flaky.
  if [ -n "$PG_CONTAINER" ]; then
    docker exec -i "$PG_CONTAINER" psql -U diversif -d postgres >/dev/null <<'SQL'
DROP DATABASE IF EXISTS diversif_e2e;
CREATE DATABASE diversif_e2e;
SQL
  else
    # Fall back to the script if we didn't spin up the container ourselves.
    E2E_DATABASE_URL="$E2E_HOST" node scripts/reset-e2e-db.mjs >/dev/null
  fi
}

cleanup_pg() {
  if [ -n "$PG_CONTAINER" ]; then
    docker stop "$PG_CONTAINER" >/dev/null 2>&1 || true
  fi
}
trap cleanup_pg EXIT

# Detection: prefer a running docker container on :5432 (most common dev
# setup), fall back to a raw TCP probe on /dev/tcp (bash builtin — `nc`
# isn't installed everywhere).
PG_CONTAINER=$(docker ps --filter publish=5432 --format '{{.Names}}' 2>/dev/null | head -1 || true)
port_open() { (echo >/dev/tcp/localhost/5432) >/dev/null 2>&1; }

if [ -n "$PG_CONTAINER" ]; then
  echo "  postgres on :5432 (container $PG_CONTAINER) — reusing"
elif port_open; then
  echo "  postgres on :5432 (non-docker) — reusing"
elif command -v docker >/dev/null 2>&1; then
  echo "  no postgres on :5432 — spinning up a throwaway container"
  PG_CONTAINER="diversif-pre-push-$$"
  docker run --rm -d --name "$PG_CONTAINER" \
    -e POSTGRES_USER=diversif -e POSTGRES_PASSWORD=diversif -e POSTGRES_DB=diversif_e2e \
    -p 5432:5432 postgres:16-alpine >/dev/null
  # Wait for postgres to accept connections.
  for _ in $(seq 1 30); do
    if docker exec "$PG_CONTAINER" pg_isready -U diversif >/dev/null 2>&1; then
      break
    fi
    sleep 0.5
  done
else
  warn "no postgres on :5432 and no docker available — skipping e2e"
  warn "CI will still gate the branch. To run e2e locally, install docker or"
  warn "expose a postgres on :5432 with user/db = diversif."
  end=$(date +%s)
  printf '\n\033[1;32mpre-push gates passed (e2e skipped) in %ss\033[0m\n' "$((end - start))"
  exit 0
fi

reset_db
E2E_DATABASE_URL="$E2E_HOST" npm run test:e2e
ok "e2e passed"

end=$(date +%s)
printf '\n\033[1;32mpre-push gates passed in %ss\033[0m\n' "$((end - start))"
