#!/usr/bin/env bash
# pre-push: run the same gates CI runs, so a broken push is caught locally
# instead of by GitHub Actions five minutes later.
#
# Set SKIP_PUSH_TESTS=1 to bypass (use only for changes you've already
# verified — e.g. docs-only — CI will still gate the branch).
set -euo pipefail

if [ "${SKIP_PUSH_TESTS:-0}" = "1" ]; then
  echo "pre-push: SKIP_PUSH_TESTS=1 set, skipping local CI mirror."
  exit 0
fi

start=$(date +%s)
log() { printf '\n\033[1;34m→ %s\033[0m\n' "$1"; }
ok()  { printf '\033[1;32m✓ %s\033[0m\n' "$1"; }
warn(){ printf '\033[1;33m! %s\033[0m\n' "$1"; }

# Surface the slow CI gates only when files in their target paths changed,
# so docs-only / unrelated pushes stay fast.
#   Coverage gate: the 100% threshold lives in CI's test:coverage job, not in
#   `bun test`. Touching the coverage surface means validating it locally.
#   Docker gate: Coolify deploys via Railpack (not docker), but the Dockerfile
#   is still used for docker-compose / self-hosting, so lint it when it changes.
CHANGED_FILES=""
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  CHANGED_FILES=$(git diff --name-only origin/main..HEAD 2>/dev/null || true)
fi
NEEDS_COVERAGE=0
NEEDS_DOCKER_CHECK=0
if printf '%s\n' "$CHANGED_FILES" | grep -qE '^(src/hooks\.|src/lib/sentry|src/lib/server/|vite\.config\.ts)'; then
  NEEDS_COVERAGE=1
fi
if printf '%s\n' "$CHANGED_FILES" | grep -qE '^(Dockerfile|\.dockerignore)'; then
  NEEDS_DOCKER_CHECK=1
fi

log "lint (prettier + eslint + i18n)"
bun run lint
ok "lint passed"

log "typecheck (svelte-check)"
bun run check
ok "typecheck passed"

if [ "$NEEDS_COVERAGE" = "1" ]; then
  log "unit + component tests (bun test --coverage, 100% threshold)"
  bun run test:coverage
  ok "coverage passed"
else
  log "unit + component tests (bun test)"
  bun run test
  ok "unit tests passed"
fi

if [ "$NEEDS_DOCKER_CHECK" = "1" ]; then
  if command -v docker >/dev/null 2>&1; then
    log "docker syntax check (BuildKit --check)"
    DOCKER_BUILDKIT=1 docker build --check . >/dev/null
    ok "docker --check passed"
  else
    warn "docker not available — Dockerfile changed but can't be checked locally (CI/deploy will)."
  fi
fi

# E2E: Playwright against a throwaway SQLite file (DATABASE_PATH) — the app
# migrates + seeds on boot and scripts/reset-e2e-db.ts wipes it first, so no
# external database service is needed. Skipped when the chromium browser isn't
# installed locally (CI always installs it).
log "e2e (Playwright, SQLite)"
if ls -d "${HOME}/.cache/ms-playwright/chromium-"* >/dev/null 2>&1; then
  bun run test:e2e
  ok "e2e passed"
else
  warn "playwright chromium not installed locally — skipping e2e."
  warn "CI still gates the branch. Install with: bun run test:e2e:install"
fi

end=$(date +%s)
printf '\n\033[1;32mpre-push gates passed in %ss\033[0m\n' "$((end - start))"
