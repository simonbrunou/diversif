# inlang SDK v2 manages project.inlang/ itself: it regenerates its own
# .gitignore, README.md, .meta.json and cache/ on every compile. Only
# settings.json and the vendored modules/ stay tracked.
project.inlang/.gitignore
project.inlang/.meta.json
project.inlang/README.md
project.inlang/cache/

