# Public origin used by SvelteKit's CSRF check and invitation links.
ORIGIN=https://diversif.app

# Path to the SQLite database file. Mounted volume in production.
DATABASE_PATH=./data/diversif.db

# Node environment.
NODE_ENV=production

# --- Reverse proxy / Cloudflare Tunnel ---
# adapter-node uses these to recover the real client IP and scheme when the
# app sits behind a proxy. Without ADDRESS_HEADER the rate limiter sees the
# proxy IP as one client and the per-IP ceilings (signup, login) effectively
# apply to the whole Internet combined.
#
# Defaults below assume a Cloudflare Tunnel terminating at Coolify/Traefik:
#   browser -> Cloudflare edge -> cloudflared -> Traefik -> Node
# Cloudflare always sets `cf-connecting-ip` to the true client IP. This is
# only safe to trust because a Tunnel origin has no public port — every
# request must transit Cloudflare, so the header can't be spoofed by a
# direct connection. If you ever expose the Coolify host directly to the
# Internet, switch to ADDRESS_HEADER=x-forwarded-for and set XFF_DEPTH to
# the number of trusted proxies between you and the client.
ADDRESS_HEADER=cf-connecting-ip
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# --- Identité légale (rendu sur /mentions-legales et /politique-confidentialite) ---
# Si une variable est manquante, la page affiche « à compléter » à sa place.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_EMAIL=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_PROVIDER=
LEGAL_HOST_PROVIDER_ADDRESS=

# --- Rétention ---
# Nombre de jours d'inactivité au-delà desquels un compte est considéré obsolète
# par scripts/list-stale-users.mjs. Aucune suppression automatique en v1.
RETENTION_INACTIVE_DAYS=1095

# --- Sentry (observability) ---
# DSN copied from the Sentry project. Empty value disables capture.
# Server-only (errors caught in hooks.server.ts).
SENTRY_DSN=
# Public DSN for browser-side capture in hooks.client.ts. May be the same
# DSN or a separate Sentry project; setting this empty disables client capture.
PUBLIC_SENTRY_DSN=
# Build-time only. Required for source-map upload to Sentry; absent =
# plugin not added, build still succeeds with minified stacks.
SENTRY_AUTH_TOKEN=
# Tag attached to every event. Defaults to "production" if unset.
SENTRY_ENVIRONMENT=production
# Mirrored to the browser; defaults to "production" if unset.
PUBLIC_SENTRY_ENVIRONMENT=production
# Release identifier (defaults to `git rev-parse HEAD` at build time).
SENTRY_RELEASE=
