# Public origin used by SvelteKit's CSRF check and invitation links.
ORIGIN=https://diversif.app

# WebAuthn relying-party ID for passkeys. Use the bare hostname only (no
# protocol, port, or path). Set this to your own domain when self-hosting
# passkeys outside diversif.app; for local Docker use localhost.
WEBAUTHN_RP_ID=diversif.app

# SQLite database file path. REQUIRED at runtime (the app throws on boot if it
# is unset). In production, Coolify mounts a persistent volume at /app/data and
# sets this; the directory MUST be writable and persist across deploys — losing
# it loses all data. drizzle-kit (db:push / db:studio) falls back to ./local.db
# when this is unset (see drizzle.config.ts).
DATABASE_PATH=/app/data/diversif.db

# Node environment.
NODE_ENV=production

# --- Reverse proxy / Cloudflare Tunnel ---
# adapter-node uses these to recover the real client IP and scheme when the
# app sits behind a proxy. Without ADDRESS_HEADER the rate limiter sees the
# proxy IP as one client and the per-IP ceilings (signup, login) effectively
# apply to the whole Internet combined.
#
# Defaults below assume a Cloudflare Tunnel terminating at Coolify/Traefik:
#   browser -> Cloudflare edge -> cloudflared -> Traefik -> Node
# Cloudflare always sets `cf-connecting-ip` to the true client IP. This is
# only safe to trust because a Tunnel origin has no public port — every
# request must transit Cloudflare, so the header can't be spoofed by a
# direct connection. If you ever expose the Coolify host directly to the
# Internet, switch to ADDRESS_HEADER=x-forwarded-for and set XFF_DEPTH to
# the number of trusted proxies between you and the client.
#
# The Docker image deliberately bakes NO default for ADDRESS_HEADER:
# adapter-node throws on every request that lacks the configured header (a
# baked default would break deployments with no proxy in front), and a
# client-supplied x-forwarded-for is spoofable. Set it here for your
# topology; the server logs a boot warning when PROTOCOL_HEADER is set
# without ADDRESS_HEADER.
ADDRESS_HEADER=cf-connecting-ip
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# --- Identité légale (rendu sur /mentions-legales et /politique-confidentialite) ---
# Si une variable est manquante, la page affiche « à compléter » à sa place.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_EMAIL=
LEGAL_CONTROLLER_ADDRESS=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_PROVIDER=
LEGAL_HOST_PROVIDER_ADDRESS=

# --- Rétention ---
# Nombre de jours d'inactivité au-delà desquels un compte est considéré obsolète
# par scripts/list-stale-users.ts. Aucune suppression automatique en v1.
RETENTION_INACTIVE_DAYS=1095

# --- Sentry (observability) ---
# DSN copied from the Sentry project. Empty value disables capture.
# Server-only. Init lives in src/instrumentation.server.ts (SvelteKit
# `kit.experimental.instrumentation.server` + `kit.experimental.tracing.server`),
# wired via sentryHandle() in hooks.server.ts. Also gates server performance
# tracing, the Sentry Logs operational log lines, and the diversif-cleanup
# cron monitor check-ins — all disabled together with this DSN.
SENTRY_DSN=
# Public DSN for browser-side capture, wired in hooks.client.ts. May be the
# same DSN or a separate Sentry project. Also enables browser performance
# tracing, error-only Session Replay, and the in-app "Signaler un problème"
# feedback form. Empty disables all browser-side Sentry capture AND makes the
# same-origin /monitoring tunnel (src/routes/monitoring/+server.ts) return 404,
# since it validates incoming envelopes against this DSN before relaying them.
PUBLIC_SENTRY_DSN=
# Build-time only. Required for source-map upload to Sentry via the
# sentrySvelteKit Vite plugin, which uploads the final adapter-node ./build
# output and deletes all .map files afterwards. Absent = plugin not added,
# build still succeeds with minified stacks.
SENTRY_AUTH_TOKEN=
# Sentry org/project slugs. Defaults match the Sentry project created
# via MCP — org "simonbrunou", project "diversif". Hosted in the EU region
# (de.sentry.io); the DSN URL encodes that.
SENTRY_ORG=simonbrunou
SENTRY_PROJECT=diversif
# Tag attached to every event, log line, and deploy marker. Defaults to
# "production" if unset.
SENTRY_ENVIRONMENT=production
# Mirrored to the browser; defaults to "production" if unset.
PUBLIC_SENTRY_ENVIRONMENT=production
# Release identifier (git SHA), used to tag events and associate uploaded
# source maps. If unset, vite.config.ts resolves SENTRY_RELEASE, then
# SOURCE_COMMIT (Coolify default), then GITHUB_SHA, then GIT_COMMIT_SHA, then
# `git rev-parse HEAD` at build time. The build emits a "No release name
# provided" warning only if none of those resolve.
# Recommended for Coolify: SENTRY_RELEASE=${SOURCE_COMMIT}
SENTRY_RELEASE=
# Sample rate for server-side performance tracing (request/load/form-action
# spans), 0–1. Values outside [0, 1] or non-numeric fall back to the default.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Sample rate for browser-side performance tracing (pageload/navigation/fetch
# spans + Web Vitals), 0–1. Same fallback behaviour as above.
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Fraction of ALL browser sessions continuously recorded as Session Replay,
# 0–1. Default 0 = no continuous recording. Replay is masked (text, input
# values, images) and does not touch sessionStorage/localStorage. The privacy
# policy (/politique-confidentialite §4) promises that nothing is recorded
# without an error: amend it BEFORE raising this above 0.
PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# Fraction of sessions that capture the buffered ~last minute as Session
# Replay when a browser error occurs, 0–1. Default 1 = always attach a replay
# to a captured error.
PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
# Optional, build-time. Enables Sentry suspect-commit association
# (owner/repo, e.g. simonbrunou/diversif). Requires the Sentry GitHub
# integration to be connected first in Sentry's org settings — leave unset
# otherwise, or the build fails.
# SENTRY_REPOSITORY=simonbrunou/diversif

# --- adapter-node body size ---
# Maximum request body size in bytes. Default is 512KB; tighten for a public
# deploy. App forms need well under 64KB, but this also caps the Sentry tunnel
# (/monitoring), hence 128KB. Measured with compression on: ~2–11KB for an
# error, ~9–17KB for a pageload/navigation trace, and 34–57KB for the first
# replay segment (full DOM snapshot + inlined stylesheets) once an error
# triggers a recording. The error always travels in its own envelope ahead of
# its replay, so an oversized replay (413) loses only the recording, and Replay
# stops for that page view. Browsers that cannot start the replay compression
# worker send uncompressed segments (~130KB) and would need 262144.
BODY_SIZE_LIMIT=131072

# --- Reverse proxy fallback ---
# If you ever stop using a Cloudflare Tunnel and expose the host directly,
# switch ADDRESS_HEADER to x-forwarded-for and set XFF_DEPTH to the number
# of trusted proxies between the client and Node. Without it, a client-set
# XFF entry can defeat the rate limiter.
# XFF_DEPTH=1

# --- Registration mode ---
# When set to 'true', registration (signup) requires a valid, unexpired
# invitation (join code). Unset or any other value keeps signup open.
# Checked before the email duplicate check to prevent email enumeration.
INVITE_ONLY=false

# --- End-to-end testing ---
# Used by Playwright e2e tests to relax security constraints (argon2id cost,
# signup rate limit) for faster test execution. REQUIRES both E2E=1 AND
# ORIGIN=http://localhost:<port> to activate — plain-http + loopback is the
# discriminating signal. A stray E2E=1 in production with https:// ORIGIN is
# inert, so this cannot accidentally weaken a real deployment. When running
# e2e tests locally, set ORIGIN manually; the e2e webServer sets it on the
# command line during CI.
E2E=0
