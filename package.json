{
  "name": "diversif",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "_bun_invocation_note": "Tools that have node-shebang bin shims (vite, svelte-check, prettier, eslint, playwright, drizzle-kit) MUST be invoked by their JS entry directly — `bun --bun TOOL` resolves the shim, which then execs `node`, so the dev/build process ends up under Node despite --bun. Calling `bun --bun node_modules/TOOL/bin/X.js` runs the JS under Bun directly. paraglide-js is the exception: see _paraglide_note.",
    "dev": "bun --bun node_modules/vite/bin/vite.js dev",
    "build": "INLANG_TELEMETRY=false bun --bun node_modules/vite/bin/vite.js build",
    "preview": "bun --bun node_modules/vite/bin/vite.js preview",
    "_paraglide_note": "paraglide-js 2.x compiles cleanly under bunx (verified 2026-06-11). The --strategy flags MUST stay in sync with paraglideVitePlugin's `strategy` in vite.config.ts — both compile into the same gitignored outdir, and a drift would make `bun run check/test` exercise a different runtime than `bun run build` ships.",
    "paraglide": "bun scripts/compile-paraglide.ts",
    "check": "bun run paraglide && bun --bun node_modules/@sveltejs/kit/src/cli.js sync && bun --bun node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "check:watch": "bun --bun node_modules/@sveltejs/kit/src/cli.js sync && bun --bun node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --threshold warning --watch",
    "check:budget": "bun run build && bun scripts/check-bundle-size.ts",
    "depcruise": "bun --bun node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config .dependency-cruiser.cjs src",
    "knip": "node_modules/.bin/knip-bun",
    "lint": "bun run paraglide && bun --bun node_modules/prettier/bin/prettier.cjs --check . && bun --bun node_modules/eslint/bin/eslint.js . && bun run lint:i18n && bun run lint:contrast",
    "lint:i18n": "bun scripts/lint-i18n.ts && bun scripts/check-i18n-unused.ts",
    "lint:contrast": "bun scripts/lint-contrast.ts",
    "format": "bun --bun node_modules/prettier/bin/prettier.cjs --write .",
    "test": "bun run paraglide && bun --bun node_modules/@sveltejs/kit/src/cli.js sync && bun scripts/bun-test.ts",
    "test:watch": "bun --conditions=browser test ./src --watch",
    "test:coverage": "bun run paraglide && bun --bun node_modules/@sveltejs/kit/src/cli.js sync && bun scripts/bun-test.ts --coverage",
    "test:e2e": "bun scripts/reset-e2e-db.ts && bun --bun node_modules/playwright/cli.js test",
    "test:e2e:install": "bun --bun node_modules/playwright/cli.js install --with-deps chromium",
    "db:generate": "bun --bun node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "bun --bun node_modules/drizzle-kit/bin.cjs push",
    "db:verify-backup": "bun scripts/verify-backup-restore.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.14.3",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^25.9.6",
    "@vite-pwa/sveltekit": "^1.1.0",
    "dependency-cruiser": "^17.4.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "fallow": "2.104.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.25.1",
    "@sentry/sveltekit": "^10.74.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bits-ui": "^2.19.2",
    "brace-expansion": "^5.0.9",
    "browserslist": "^4.28.9",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-uri": "^4.1.4",
    "lucide-svelte": "^1.0.1",
    "nanoid": "^6.0.1",
    "postcss": "^8.5.28",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "overrides": {
    "cookie": "^1.0.0",
    "esbuild": "^0.28.1",
    "@opentelemetry/core": "^2.8.0",
    "devalue": "^5.6.4",
    "sha.js": "^2.4.12",
    "solid-js": "^1.9.4"
  },
  "trustedDependencies": [
    "@sentry/cli"
  ]
}
