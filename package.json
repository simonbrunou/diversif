{
  "name": "diversif",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "NODE_OPTIONS='--unhandled-rejections=warn' vite build",
    "preview": "vite preview",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning --watch",
    "lint": "npm run paraglide && prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "npm run paraglide && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run paraglide && vitest run --coverage",
    "test:e2e": "node scripts/reset-e2e-db.mjs && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,svelte}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@inlang/paraglide-sveltekit": "^0.16.1",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^2.23.1",
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.45.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.11.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "svelte": "^5.55.7",
    "svelte-check": "^4.0.5",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@inlang/paraglide-js": "^1.11.8",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/sveltekit": "^8.55.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@types/pg": "^8.20.0",
    "@vite-pwa/sveltekit": "^0.6.7",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.45.2",
    "lucide-svelte": "^0.453.0",
    "pg": "^8.20.0",
    "pg-mem": "^3.0.14",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^2.5.4",
    "tailwind-variants": "^0.2.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "esbuild": "^0.25.0",
    "devalue": "^5.6.4",
    "sha.js": "^2.4.12",
    "solid-js": "^1.9.4"
  }
}
